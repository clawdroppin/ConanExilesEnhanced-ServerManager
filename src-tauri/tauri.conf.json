{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Conan Exiles Enhanced Server Manager",
  "version": "1.0.2",
  "identifier": "com.conanexiles.enhancedmanager",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1430",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "create": false,
        "title": "Conan Exiles Enhanced Server Manager",
        "width": 1480,
        "height": 920,
        "minWidth": 1080,
        "minHeight": 680,
        "decorations": false,
        "transparent": false,
        "center": true,
        "visible": false,
        "backgroundColor": "#0a0807"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: https://images.steamusercontent.com https://steamuserimages-a.akamaihd.net https://*.steamstatic.com; style-src 'self' 'unsafe-inline'; font-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "msi"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "category": "Utility",
    "shortDescription": "Conan Exiles: Enhanced dedicated server manager",
    "longDescription": "Install, configure, mod, monitor, back up and automate Conan Exiles: Enhanced dedicated servers.",
    "windows": {
      "webviewInstallMode": {
        "type": "embedBootstrapper"
      },
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "publisher": "clawdroppin",
    "copyright": "Copyright (c) 2026 clawdroppin - MIT License",
    "homepage": "https://github.com/clawdroppin/ConanExilesEnhanced-ServerManager"
  }
}